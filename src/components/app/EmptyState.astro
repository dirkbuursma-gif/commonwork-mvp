---
interface Props {
  title: string;
  description: string;
  symbol?: string;
}

const { title, description, symbol = '·' } = Astro.props;
---

<div class="empty-state">
  <span class="empty-symbol" aria-hidden="true">{symbol}</span>
  <h2>{title}</h2>
  <p>{description}</p>
  <div class="empty-actions"><slot /></div>
</div>
