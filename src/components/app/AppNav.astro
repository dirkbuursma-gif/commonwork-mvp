---
import BrandMark from '../BrandMark.astro';

interface Props {
  active: 'today' | 'competence' | 'find' | 'introductions' | 'events' | 'intelligence' | 'none';
  name: string;
  email: string;
}

const { active, name, email } = Astro.props;
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');

const links = [
  { id: 'today', label: 'Today', short: 'Today', href: '/today' },
  { id: 'competence', label: 'My competence', short: 'Offer', href: '/competence' },
  { id: 'find', label: 'Find competence', short: 'Find', href: '/find' },
  { id: 'intelligence', label: 'Intelligence', short: 'Intel', href: '/intelligence' },
  { id: 'introductions', label: 'Introductions', short: 'Intros', href: '/introductions' },
  { id: 'events', label: 'Events', short: 'Events', href: '/events' },
] as const;
---

<aside class="sidebar">
  <a class="brand" href="/today" aria-label="Commonwork home">
    <BrandMark />
    <span>Commonwork</span>
  </a>

  <nav class="nav-group" aria-label="Workspace">
    <span class="nav-label">Workspace</span>
    {links.map((link) => (
      <a
        class:list={['nav-link', { active: active === link.id }]}
        href={link.href}
        aria-current={active === link.id ? 'page' : undefined}
      >
        <span class="nav-glyph" aria-hidden="true">·</span>
        <span>{link.label}</span>
      </a>
    ))}
  </nav>

  <div class="profile-chip" aria-label={`Signed in as ${name}`}>
    <span class="avatar" aria-hidden="true">{initials || 'CW'}</span>
    <span class="profile-copy">
      <strong>{name}</strong>
      <span>{email}</span>
    </span>
  </div>
</aside>

<nav class="mobile-nav" aria-label="Workspace">
  {links.map((link) => (
    <a
      class:list={['nav-link', { active: active === link.id }]}
      href={link.href}
      aria-current={active === link.id ? 'page' : undefined}
    >
      <span class="nav-glyph" aria-hidden="true">·</span>
      <span>{link.short}</span>
    </a>
  ))}
</nav>
