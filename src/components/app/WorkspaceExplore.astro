---
import { getLisbonEventContextBySlug } from '../../lib/events/lisbon-context';
const routeEvent = /^\/events\/([a-z0-9]+(?:-[a-z0-9]+)*)(?:\/|$)/.exec(Astro.url.pathname)?.[1];
const context = getLisbonEventContextBySlug(routeEvent || Astro.url.searchParams.get('from_event'));
const links = [
  { label: 'Insights', path: '/insights' },
  { label: 'Providers & products', path: '/catalogue' },
  { label: 'Events', path: '/discover/events' },
  { label: 'About', path: '/about' },
].map((link) => {
  const target = new URL(link.path, Astro.url.origin);
  if (context) target.searchParams.set('from_event', context.eventSlug);
  const active = Astro.url.pathname === link.path || (link.path === '/insights' && Astro.url.pathname.startsWith('/insights/')) || (link.path === '/catalogue' && Astro.url.pathname.startsWith('/catalogue/')) || (link.path === '/discover/events' && Boolean(context));
  return { ...link, href: target.pathname + target.search, active };
});
---
<nav class="workspace-explore" aria-label="Public navigation">
  <div class="explore-desktop">{links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}</div>
  <details class="explore-mobile"><summary>Explore Commonwork</summary><div>{links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}</div></details>
</nav>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.explore-mobile').forEach((menu) => {
    menu.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
    document.addEventListener('click', (event) => { if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
  });
</script>
<style>
.workspace-explore{position:relative;min-width:0}.explore-desktop{display:flex;align-items:center;flex-wrap:wrap;gap:0 20px}.workspace-explore a{display:inline-flex;align-items:center;min-height:44px;color:var(--brand-primary);font-size:.88rem;font-weight:600;text-decoration:none}.workspace-explore a:hover{text-decoration:underline}.workspace-explore a[aria-current='page']{font-weight:800;text-decoration:underline;text-underline-offset:.4em}.explore-mobile{display:none}.explore-mobile summary{cursor:pointer;min-height:44px;padding:10px 0;font-weight:700}.explore-mobile>div{position:absolute;top:100%;left:0;z-index:30;display:grid;min-width:220px;padding:12px 18px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--card);box-shadow:var(--shadow)}
@media(max-width:1050px){.explore-desktop{display:none}.explore-mobile{display:block}}
</style>
