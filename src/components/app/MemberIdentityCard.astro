---
import MemberAvatar from './MemberAvatar.astro';
import type { MemberAvatarId, MemberIdentity } from '../../lib/member-identity';
interface Props { identity: Pick<MemberIdentity, 'display_name' | 'username' | 'avatar_id'>; compact?: boolean; followingCount?: number | null; companyFollowingCount?: number | null; }
const { identity, compact = false, followingCount = null, companyFollowingCount = null } = Astro.props;
const followingLabel = followingCount === null ? 'Following products' : `Following products, ${followingCount}`;
const companyFollowingLabel = companyFollowingCount === null ? 'Following companies' : `Following companies, ${companyFollowingCount}`;
const displayName = identity.display_name.trim() || 'Member';
const avatarId: MemberAvatarId = identity.avatar_id || 'initials';
---
{compact ? (
  <details class="member-identity-compact">
    <summary aria-label="Member identity and profile links">
      <MemberAvatar displayName={displayName} avatarId={avatarId} size="small" />
      <span class="member-identity-compact-copy"><strong>{displayName}</strong>{identity.username && <span>@{identity.username}</span>}</span>
      <span class="member-identity-chevron" aria-hidden="true">⌄</span>
    </summary>
    <nav aria-label="Member profile links"><a href="/profiles/me">View profile</a><a href="/onboarding?step=contribution">Edit profile</a><a href="/introductions">My introductions</a><a href="/following" aria-label={followingLabel}>Following products{followingCount !== null && <span class="member-identity-count" aria-hidden="true">{followingCount}</span>}</a><a href="/following" aria-label={companyFollowingLabel}>Following companies{companyFollowingCount !== null && <span class="member-identity-count" aria-hidden="true">{companyFollowingCount}</span>}</a></nav>
  </details>
) : (
  <section class="member-identity-card" aria-label="Your identity">
    <a class="member-identity-primary" href="/profiles/me" aria-label="View profile">
      <MemberAvatar displayName={displayName} avatarId={avatarId} />
      <span class="member-identity-copy"><strong>{displayName}</strong>{identity.username && <span>@{identity.username}</span>}</span>
    </a>
    <nav aria-label="Member profile links"><a href="/onboarding?step=contribution">Edit profile</a><a href="/introductions">My introductions</a><a href="/following" aria-label={followingLabel}>Following products{followingCount !== null && <span class="member-identity-count" aria-hidden="true">{followingCount}</span>}</a><a href="/following" aria-label={companyFollowingLabel}>Following companies{companyFollowingCount !== null && <span class="member-identity-count" aria-hidden="true">{companyFollowingCount}</span>}</a></nav>
  </section>
)}