---
import AppNav from '../components/app/AppNav.astro';
import WorkspaceExplore from '../components/app/WorkspaceExplore.astro';
import ThemeToggle from '../components/app/ThemeToggle.astro';
import MemberIdentityCard from '../components/app/MemberIdentityCard.astro';
import SupportContact from '../components/app/SupportContact.astro';
import { createSupabaseServerClient } from '../lib/supabase/server';
import { getMyIdentity, type MemberIdentity } from '../lib/member-identity';
import { getMyFollowedProductCount } from '../lib/product-follows';
import { getMyFollowedProviderCount } from '../lib/company-follows';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
interface Props { title: string; section: 'today' | 'competence' | 'find' | 'introductions' | 'events' | 'intelligence' | 'publishing' | 'none'; description?: string; editorial?: boolean; }
const { title, section, description = 'Commonwork connects competence to real business needs through trusted introductions.', editorial = false } = Astro.props;
const user = Astro.locals.user;
let identity: MemberIdentity = { profile_id: user?.id ?? '', display_name: 'Member', username: null, avatar_id: 'initials' };
let followingCount: number | null = null;
let companyFollowingCount: number | null = null;
let hasCompanyPublishing = false;
if (user && !user.isLocalTestUser) {
  const client = createSupabaseServerClient(Astro);
  if (client) {
    // Each value degrades independently; an unknown count is hidden rather than guessed.
    const [identityResult, productCountResult, companyCountResult] = await Promise.allSettled([
      getMyIdentity(client), getMyFollowedProductCount(client), getMyFollowedProviderCount(client),
    ]);
    if (identityResult.status === 'fulfilled') identity = identityResult.value ?? identity;
    if (productCountResult.status === 'fulfilled') followingCount = productCountResult.value;
    if (companyCountResult.status === 'fulfilled') companyFollowingCount = companyCountResult.value;
    const { data: publishingScopes } = await client.rpc('list_my_company_publishing_scopes');
    hasCompanyPublishing = Boolean(publishingScopes?.length);
  }
}
---
<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=commonwork-1" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#f5f2f0" /><meta name="description" content={description} /><title>{title} · Commonwork</title></head>
<body class:list={{ 'public-site': editorial }}>
<a class="shell-skip" href="#main-content">Skip to content</a>
<div class="app-frame"><AppNav active={section} identity={identity} followingCount={followingCount} companyFollowingCount={companyFollowingCount} hasCompanyPublishing={hasCompanyPublishing} /><div class="main-shell">
<header class="topbar shared-topbar"><div class="shell-navigation"><button class="btn sidebar-toggle" type="button" aria-controls="workspace-sidebar" aria-expanded="true" aria-label="Toggle workspace sidebar">My workspace</button><WorkspaceExplore /><MemberIdentityCard identity={identity} followingCount={followingCount} companyFollowingCount={companyFollowingCount} compact={true} /></div><div class="topbar-actions">
{user?.isLocalTestUser && <form class="dev-session-form" method="post" action="/api/auth/end-test-session"><span class="dev-session-label">Local test session</span><button class="btn" type="submit">End test session</button></form>}
{user && !user.isLocalTestUser && <form method="post" action="/api/auth/sign-out"><button class="btn" type="submit">Sign out</button></form>}<ThemeToggle /></div></header>
<main id="main-content" class:list={{ 'editorial-main': editorial }}><div class="breadcrumb shell-breadcrumb">Commonwork <span aria-hidden="true">/</span> {title}</div><slot /></main><SupportContact />
</div></div>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
if (toggle) {
  const root = document.documentElement;
  const apply = (collapsed: boolean) => { root.dataset.workspaceCollapsed = String(collapsed); toggle.setAttribute('aria-expanded', String(!collapsed)); };
  try { apply(localStorage.getItem('commonwork_workspace_collapsed') === 'true'); } catch { apply(false); }
  toggle.addEventListener('click', () => { const collapsed = root.dataset.workspaceCollapsed !== 'true'; apply(collapsed); try { localStorage.setItem('commonwork_workspace_collapsed', String(collapsed)); } catch {} });
}
</script>
</body></html>
<style is:global>
.shared-topbar{height:auto;min-height:76px;flex-wrap:wrap;padding-block:10px}.shell-navigation{display:flex;align-items:center;gap:20px;min-width:0}.shell-breadcrumb{margin-bottom:24px}.shell-skip{position:fixed;top:8px;left:8px;transform:translateY(-180%);z-index:100;background:var(--card);padding:12px}.shell-skip:focus{transform:none}
@media(min-width:768px){html[data-workspace-collapsed='true'] .app-frame{grid-template-columns:minmax(0,1fr)}html[data-workspace-collapsed='true'] #workspace-sidebar{display:none}}
@media(max-width:767px){.btn.sidebar-toggle{display:none}.shared-topbar{padding-inline:16px;gap:8px}.shell-navigation{gap:8px}.shared-topbar .topbar-actions{gap:6px}.public-site .main-shell .editorial-main{padding-bottom:100px}.public-site .main-shell{padding-bottom:72px}}
</style>
