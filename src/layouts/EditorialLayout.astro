---
import ThemeToggle from '../components/app/ThemeToggle.astro';
import BrandMark from '../components/BrandMark.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/insights.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const eventMatch = /^\/events\/([a-z0-9]+(?:-[a-z0-9]+)*)(?:\/|$)/.exec(Astro.url.pathname);
const eventHome = eventMatch ? `/events/${eventMatch[1]}/resources` : undefined;
const signIn = `/sign-in${Astro.url.pathname.startsWith('/insights/') ? `?return_to=${encodeURIComponent(Astro.url.pathname)}` : ''}`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2f0" />
    <meta name="description" content={description} />
    <title>{title} · {eventHome ? 'Commonwork' : 'Commonwork Insights'}</title>
  </head>
  <body>
    <header class="editorial-header">
      <a class="editorial-brand" href={eventHome || '/insights'} aria-label={eventHome ? 'Commonwork session resources' : 'Commonwork Insights home'}>
        <BrandMark /><span>Commonwork</span>
      </a>
      <nav class="editorial-nav" aria-label="Public navigation">
        <a class="editorial-insights-link" href={eventHome || '/insights'} aria-current={eventHome || Astro.url.pathname.startsWith('/insights') ? 'page' : undefined}>{eventHome ? 'Session resources' : 'Insights'}</a>
        <div class="editorial-desktop-links">
          {eventHome && <a href="/insights">Insights</a>}
          <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About Commonwork</a>
          {Astro.locals.user ? <a href="/account" aria-current={Astro.url.pathname === '/account' ? 'page' : undefined}>Your account</a> : <a href={signIn}>Sign in</a>}
          <ThemeToggle />
        </div>
        <button class="editorial-menu-toggle" type="button" aria-label="Open menu" aria-controls="editorial-mobile-menu" aria-expanded="false" hidden>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </button>
        <div class="editorial-mobile-menu" id="editorial-mobile-menu" hidden>
          {eventHome && <a href="/insights">Insights</a>}
          <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About Commonwork</a>
          {Astro.locals.user ? <a href="/account" aria-current={Astro.url.pathname === '/account' ? 'page' : undefined}>Your account</a> : <a href={signIn}>Sign in</a>}
          <div class="editorial-mobile-theme"><ThemeToggle /></div>
        </div>
      </nav>
    </header>
    <main id="main-content" class="editorial-main"><slot /></main>
    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>('.editorial-menu-toggle');
      const menu = document.querySelector<HTMLDivElement>('#editorial-mobile-menu');
      if (menuToggle && menu) {
        const setMenuOpen = (isOpen: boolean) => {
          menu.hidden = !isOpen;
          menuToggle.setAttribute('aria-expanded', String(isOpen));
          menuToggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
        };
        const navigation = menuToggle.closest('nav');
        menuToggle.hidden = false;
        menuToggle.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
        navigation?.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') { setMenuOpen(false); menuToggle.focus(); }
        });
        document.addEventListener('click', (event) => {
          if (menuToggle.getAttribute('aria-expanded') === 'true' && event.target instanceof Node && !menu.contains(event.target) && !menuToggle.contains(event.target)) setMenuOpen(false);
        });
      }
    </script>
  </body>
</html>
