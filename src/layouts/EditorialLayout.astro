---
import ThemeToggle from '../components/app/ThemeToggle.astro';
import BrandMark from '../components/BrandMark.astro';
import { createSupabaseServerClient } from '../lib/supabase/server';
import { readWorkspaceAccess } from '../lib/workspace-access';
import { getLisbonEventContextBySlug } from '../lib/events/lisbon-context';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/insights.css';
import '../styles/public-pages.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const user = Astro.locals.user;
const local = import.meta.env.DEV && user?.isLocalTestUser === true;
const client = user && !local ? createSupabaseServerClient(Astro) : null;
const member = local || (client ? await readWorkspaceAccess(client) : false);
const routeEvent = /^\/events\/([a-z0-9]+(?:-[a-z0-9]+)*)(?:\/|$)/.exec(Astro.url.pathname)?.[1];
const eventContext = getLisbonEventContextBySlug(routeEvent || Astro.url.searchParams.get('from_event'));
const eventHome = eventContext ? `/events/${eventContext.eventSlug}/resources` : undefined;
const publicLink = (path: string) => { const target = new URL(path, Astro.url.origin); if (eventContext) target.searchParams.set('from_event', eventContext.eventSlug); return `${target.pathname}${target.search}${target.hash}`; };
const links = [
  { label: 'Events', path: '/discover/events' }, { label: 'Insights', path: '/insights' },
  { label: 'Catalogue', path: '/catalogue' }, { label: 'About', path: '/about' },
].map((link) => ({ ...link, href: publicLink(link.path), active: Astro.url.pathname === link.path || (link.path === '/insights' && Astro.url.pathname.startsWith('/insights/')) }));
const accountLink = member ? '/today' : user ? '/account' : '/sign-in';
const accountLabel = member ? 'My workspace' : user ? 'Your account' : 'Sign in';
---
<!doctype html>
<html lang="en" data-theme="light">
<head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=commonwork-1" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#f5f2f0" /><meta name="description" content={description} /><title>{title} · Commonwork</title></head>
<body class="public-site">
<header class="editorial-header">
<a class="editorial-brand" href={publicLink('/about')} aria-label="About Commonwork"><BrandMark /><span>Commonwork</span></a>
<nav class="public-navigation" aria-label="Public navigation">
<div class="public-desktop">{links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}{!member && <a class="public-join" href={publicLink('/about#join')}>Join Commonwork</a>}<a href={accountLink}>{accountLabel}</a><ThemeToggle /></div>
<details class="public-mobile"><summary aria-controls="public-mobile-links" aria-expanded="false">Menu</summary><div class="public-mobile-links" id="public-mobile-links">{links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}{!member && <a class="public-join" href={publicLink('/about#join')}>Join Commonwork</a>}<a href={accountLink}>{accountLabel}</a><ThemeToggle /></div></details>
</nav></header>
<main id="main-content" class="editorial-main">{eventContext && eventHome && <nav class="public-event-context" aria-label="Session context"><a href={eventHome}>← Back to session resources</a><span>{eventContext.eventTitle}</span></nav>}<slot /></main>
<footer class="public-footer"><p>Commonwork · Useful work, in good company.</p><nav aria-label="Participation and contact"><a href={publicLink('/about#join')}>Membership</a><a href={publicLink('/about#insights-updates')}>Insights updates</a><a href="mailto:dirk.buursma@commerce-partners.com">Contact</a></nav></footer>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.public-mobile');
  const toggle = menu?.querySelector<HTMLElement>('summary');
  if (menu && toggle) {
    const sync = () => toggle.setAttribute('aria-expanded', String(menu.open));
    sync();
    menu.addEventListener('toggle', sync);
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) { event.preventDefault(); menu.open = false; sync(); toggle.focus(); }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) { menu.open = false; sync(); }
    });
  }
</script>
</body></html>
<style>
.public-navigation{position:relative}.public-desktop{display:flex;align-items:center;gap:1rem;font-size:.9rem}.public-navigation a{text-decoration:none}.public-navigation a:hover{text-decoration:underline}.public-navigation a[aria-current='page']{font-weight:700;color:var(--brand-primary)}.public-join{display:inline-block;padding:.6rem .85rem;border:1px solid var(--brand-primary);border-radius:var(--radius-sm);color:var(--brand-primary);font-weight:700}.public-mobile{display:none}.public-event-context{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem}.public-event-context a{color:var(--brand-primary);font-weight:700}.public-event-context span{color:var(--muted)}
@media(max-width:1050px){.public-desktop{display:none}.public-mobile{display:block}.public-mobile summary{cursor:pointer;min-height:44px;padding:.65rem;font-weight:700}.public-mobile-links{position:absolute;top:100%;right:0;z-index:20;display:grid;gap:.5rem;min-width:230px;padding:1rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--card);box-shadow:var(--shadow)}.public-mobile-links>a{padding:.55rem}.public-event-context{flex-direction:column}}
</style>
