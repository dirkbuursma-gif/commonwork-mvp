---
import AuthLayout from '../layouts/AuthLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import { validateIntelligenceReturnPath } from '../lib/auth-return-path';

const configured = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);
const status = Astro.url.searchParams.get('status');
const returnPath = validateIntelligenceReturnPath(Astro.url.searchParams.get('return_to'));
const notices: Record<string, { text: string; error: boolean }> = {
  'signed-out': { text: 'You have signed out.', error: false },
  invalid: { text: 'Enter a valid email address and try again.', error: true },
  unavailable: { text: 'We could not send a sign-in code just now. Please try again shortly.', error: true },
  'rate-limited': { text: 'Too many sign-in codes have been requested. Please wait a while before requesting another.', error: true },
  expired: { text: 'Your sign-in session has expired. Enter your email address to request a new code.', error: true },
  'invalid-link': { text: 'That sign-in link is invalid or has expired. Request a sign-in code instead.', error: true },
  configuration: { text: 'Sign-in is not configured yet. Contact your Commonwork administrator.', error: true },
};
const notice = status ? notices[status] : undefined;
---

<AuthLayout title="Sign in">
  <main class="auth-page">
    <section class="auth-intro" aria-label="Commonwork">
      <a class="brand" href="/sign-in">
        <BrandMark />
        <span>Commonwork</span>
      </a>
      <div class="auth-copy">
        <div class="eyebrow">Competence, in good company</div>
        <h1>Make useful work visible.</h1>
        <p>Connect what you know with what someone needs, through an introduction that makes sense to both of you.</p>
      </div>
      <p class="auth-note">A private professional network for thoughtful work and trusted introductions.</p>
    </section>

    <section class="auth-side">
      <div class="auth-card">
        <div class="eyebrow">Invite-only access</div>
        <h2>Sign in to Commonwork</h2>
        <p>Use the email address connected to your invitation. We’ll email you a code to sign in.</p>
        {notice && <p class:list={['form-notice', { error: notice.error }]} role="status">{notice.text}</p>}
        {configured ? (
          <form method="post" action="/api/auth/sign-in" data-submit-once>
            {returnPath && <input type="hidden" name="return_to" value={returnPath} />}
            <label class="field" for="email">
              Email address
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
            </label>
            <button class="btn primary" type="submit">Email me a code</button>
            <p class="form-footnote">New accounts can only be created by invitation.</p>
          </form>
        ) : (
          <p class="form-notice error" role="status">Supabase is not configured yet. Sign-in will be available after the project environment is connected.</p>
        )}
        {import.meta.env.DEV && (
          <div class="dev-access">
            <p class="form-footnote">Local preview only. This test session does not connect to Supabase.</p>
            <form method="post" action="/api/auth/test-session">
              <button class="btn" type="submit">Enter local test workspace</button>
            </form>
          </div>
        )}
      </div>
    </section>
  </main>
</AuthLayout>

<script>
  import { enableSubmitOnce } from '../lib/submit-once';
  enableSubmitOnce();
</script>
