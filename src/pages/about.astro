---
import InsightsLayout from '../layouts/InsightsLayout.astro';
import { getLisbonEventContextBySlug } from '../lib/events/lisbon-context';
export const prerender = false;
const contact = (subject: string) => `mailto:dirk.buursma@commerce-partners.com?subject=${encodeURIComponent(subject)}`;
const context = getLisbonEventContextBySlug(Astro.url.searchParams.get('from_event'));
const publicLink = (path: string) => context ? `${path}?from_event=${encodeURIComponent(context.eventSlug)}` : path;
---
<InsightsLayout title="About Commonwork" description="Explore Commonwork membership, Insights updates and event participation.">
  <article class="about-page">
    <h1>Useful work, in good company.</h1>
    <p class="lede">Explore ideas, discover relevant expertise and meet around meaningful work.</p>
    <p>Commonwork connects people and useful work by making professional competence visible and helping members find relevant expertise through trusted introductions.</p>
    <p>Public events, Insights and catalogue summaries offer a way to explore before deciding how to participate. Private member profiles and evidence remain separate.</p>
    <section id="join" aria-labelledby="join-heading">
      <h2 id="join-heading">Become a member</h2>
      <p>Make your competence visible and express interest in relevant introductions. Membership is reviewed separately; requesting membership does not guarantee approval or an introduction.</p>
      <a class="about-signin" href={contact('Commonwork membership enquiry')}>Enquire about membership</a>
      <p class="participation-note">Opens an email draft. Membership requests are currently handled personally. Do not include confidential documents or sensitive personal information.</p>
    </section>
    <section id="insights-updates" aria-labelledby="updates-heading">
      <h2 id="updates-heading">Follow Insights</h2>
      <p>Read reviews and perspectives without creating a member profile. Interest in Insights updates is separate from membership and event registration.</p>
      <a class="about-signin" href={contact('Request information about Commonwork Insights updates')}>Ask about Insights updates</a>
      <p class="participation-note">Opens an email draft, not an automatic subscription. We will confirm update preferences separately.</p>
    </section>
    <section id="events" aria-labelledby="events-heading">
      <h2 id="events-heading">Meet through events</h2>
      <p>Explore public session resources and express interest in future events. Attendance requirements and registration are specific to each event. Reading resources does not register you as an attendee.</p>
      <p><a href={publicLink('/discover/events')}>Explore public events and session resources →</a></p>
      <a class="about-signin" href={contact('Commonwork event participation enquiry')}>Ask about future events</a>
      <p class="participation-note">Opens an email draft. Event registration and any update preferences will be confirmed separately.</p>
    </section>
    <section id="catalogue" aria-labelledby="catalogue-heading">
      <h2 id="catalogue-heading">Discover the catalogue</h2>
      <p>The public catalogue overview starts with selected offering summaries already shared through public sessions. Explore the jobs they address and follow the provider sources.</p>
      <p><a href={publicLink('/catalogue')}>Browse the public catalogue →</a></p>
      <p>Full member catalogue pages still require workspace membership. Public summaries do not expose private member information.</p>
      <a class="about-signin" href={contact('Commonwork catalogue and introductions enquiry')}>Discuss a need or introduction</a>
      <p class="participation-note">An enquiry does not share your details with a provider or guarantee an introduction.</p>
    </section>
    <p class="existing-account">Already have an invitation or account? <a href="/sign-in">Sign in with your email code</a>.</p>
  </article>
</InsightsLayout>
<style>
  .about-page section { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); scroll-margin-top: 1.5rem; }
  .participation-note { margin-top: .85rem; font-size: .9rem; color: var(--muted); }
  .existing-account { margin-top: 2rem; }
</style>
