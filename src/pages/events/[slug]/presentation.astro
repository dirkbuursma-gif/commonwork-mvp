---
import PlaybookLayout from '../../../layouts/PlaybookLayout.astro';
import { event, influenceActors, panelDebatePrompts, sections, sourceById } from '../../../lib/playbook/content';
import { perplexityStrollerExample } from '../../../lib/playbook/perplexity-stroller-example';
import {
  audienceToolRoles,
  presentationExpertWorkflows,
  presentationFirstMonthSteps,
  presentationFoundationSteps,
  presentationSectionCopy,
  presentationVisibilityQuestions,
} from '../../../lib/playbook/audience-guide';
import { createSupabaseServerClient } from '../../../lib/supabase/server';
import { getEventMaterialAccess } from '../../../lib/events/material-access';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.isLocalTestUser) {
  return new Response('Approved event attendee access is required.', {
    status: user ? 403 : 401,
    headers: { 'Cache-Control': 'private, no-store' },
  });
}

const supabase = createSupabaseServerClient(Astro);
if (!supabase) {
  return new Response('Event materials are not configured.', {
    status: 503,
    headers: { 'Cache-Control': 'private, no-store' },
  });
}

const access = await getEventMaterialAccess(supabase, Astro.params.slug ?? '', user.id);
if (access.status !== 'available') {
  return new Response(access.status === 'not-found' ? 'Event not found.' : 'Approved event attendee access is required.', {
    status: access.status === 'not-found' ? 404 : 403,
    headers: { 'Cache-Control': 'private, no-store' },
  });
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
const eventHome = `/events/${access.event.slug}`;
const guideAvailable = access.materials.some((material) => material.kind === 'guide');
---

<PlaybookLayout title={`${access.event.title} · presentation`} mode="present">
  <div class="pb-deck" data-deck>
    <header class="pb-deck-top">
      <div class="pb-brand">
        <span class="pb-wordmark">Commonwork</span>
      </div>
      <div class="pb-header-actions">
        <button class="pb-btn" type="button" data-fullscreen hidden>Full screen</button>
        {guideAvailable && <a class="pb-btn" href={`${eventHome}/guide`}>Audience guide</a>}
        <a class="pb-btn" href={eventHome}>Back to event</a>
      </div>
    </header>

    <main class="pb-slides" id="main">
      <section class="pb-slide pb-slide-opening" id="opening" data-slide aria-labelledby="opening-title">
        <div class="pb-slide-inner">
          <div class="pb-opening-copy">
            <h1 id="opening-title">Agentic Commerce: When AI Enters the Shopping Journey</h1>
            <p class="pb-opening-subtitle">From product discovery to decision intermediaries: what brands and retailers control.</p>
          </div>
          <div class="pb-opening-identities">
            <section class="pb-opening-presenter" aria-labelledby="opening-presenter-name">
              <h2 id="opening-presenter-name">Dirk Buursma</h2>
              <p>Commerce Partners</p>
            </section>
            <section class="pb-opening-network" aria-labelledby="opening-network-name">
              <p class="pb-eyebrow">Introducing Commonwork</p>
              <h2 id="opening-network-name">Commonwork</h2>
              <p>The Collaborative Commerce Network</p>
            </section>
          </div>
        </div>
      </section>
      {
        sections.map((section) => (
          <section class="pb-slide" id={section.id} data-slide aria-labelledby={`${section.id}-title`}>
            <div class="pb-slide-inner">
              <p class="pb-eyebrow">
                {event.location} · Section {section.number} of {sections.length}
              </p>
              <h1 id={`${section.id}-title`}>{presentationSectionCopy[section.id]?.title ?? section.title}</h1>
              <p class="pb-slide-summary">{presentationSectionCopy[section.id]?.summary ?? section.summary}</p>

              {section.id === 'decision-before-visit' && (
                <div class="pb-slide-reality" aria-label="Editorial summary of the supplied Perplexity response">
                  <p class="pb-slide-reality-label">{perplexityStrollerExample.editorialSummaryLabel}</p>
                  <p class="pb-slide-request">{perplexityStrollerExample.requestSummary}</p>
                  <blockquote class="pb-slide-recommendation">“{perplexityStrollerExample.recommendation}”</blockquote>
                  <div class="pb-slide-products">
                    {perplexityStrollerExample.products.map((product) => (
                      <article class="pb-slide-product">
                        <h2>{product.name}</h2>
                        <p>{product.destination}</p>
                        <nav aria-label={`Retailer source for ${product.name}`}>
                          {product.sourceIds.map((sourceId) => {
                            const source = perplexityStrollerExample.sources.find((item) => item.id === sourceId);
                            return source && <a href={source.url} target="_blank" rel="noreferrer">[{source.id}]</a>;
                          })}
                        </nav>
                      </article>
                    ))}
                  </div>
                  <div class="pb-slide-retailer-questions">
                    {perplexityStrollerExample.visibilityQuestions.map((question) => <p>{question}</p>)}
                  </div>
                  <p class="pb-slide-note">{perplexityStrollerExample.stageFooter}</p>
                  <p class="pb-slide-reality-meta">Destinations are reported in one supplied response; verify current offers.</p>
                </div>
              )}

              {section.id === 'shopper-assistant-today' && (
                <div class="pb-slide-intermediaries" aria-label="Capability types and separate checkout example">
                  <article><span>01</span><h2>Research</h2><p>Find and interpret information for a customer task.</p></article>
                  <article><span>02</span><h2>Recommend</h2><p>Compare options against the request and preferences.</p></article>
                  <article class="pb-slide-checkout-example">
                    <span>03 · Separate published example</span>
                    <h2>Delegated checkout</h2>
                    <p>OpenAI · 29 September 2025 · source describes U.S. users and participating sellers.</p>
                    <p>User confirms order, shipping and payment details; seller handles acceptance and fulfillment.</p>
                    <a href={sourceById['openai-instant-checkout'].url} target="_blank" rel="noreferrer">Open OpenAI source</a>
                  </article>
                  <p class="pb-slide-note">Research, recommendation and checkout are distinct capabilities. The Perplexity example above does not show a purchase.</p>
                </div>
              )}

              {section.showVisibilityModel && (
                <div class="pb-slide-influence-map" aria-label="Illustrative influence map, not a technical architecture">
                  {influenceActors.filter((actor) => actor.id !== 'assistant').map((actor) => (
                    <article class:list={['pb-slide-map-node', `pb-slide-map-node-${actor.id}`]}>
                      <strong>{actor.label}</strong>
                      <span class="pb-slide-map-arrow" aria-hidden="true">
                        {actor.id === 'shopper' ? '↓' : actor.id === 'brand' ? '→' : actor.id === 'retailer' ? '←' : '↑'}
                      </span>
                    </article>
                  ))}
                  <div class="pb-slide-map-center">Assistant response</div>
                </div>
              )}
              {section.showVisibilityModel && (
                <div class="pb-slide-map-caveat">
                  <p>Illustrative influence map—not a documented technical architecture or a complete factor list.</p>
                  <p>Influence is not control. No participant can guarantee placement.</p>
                </div>
              )}

              {section.showVisibilityQuestions && (
                <div class="pb-slide-visibility" aria-label="Three separate visibility checks">
                  {presentationVisibilityQuestions.map((item, index) => (
                    <article>
                      <span class="pb-slide-influence-number">0{index + 1}</span>
                      <h2>{item.label}</h2>
                      <strong>{item.question}</strong>
                    </article>
                  ))}
                  <p class="pb-muted">Analytical questions—not answers asserted for a particular retailer.</p>
                </div>
              )}

              {section.id === 'check-your-visibility' && (
                <div class="pb-slide-workflows" aria-label="Proposed expert and AI workflows">
                  {presentationExpertWorkflows.map((workflow) => (
                    <article class="pb-slide-workflow-card">
                      <h2>{workflow.title}</h2>
                      <p><strong>Task</strong> {workflow.objective}</p>
                      <p><strong>Expert judgement</strong> {workflow.expert}</p>
                      <p><strong>AI contribution</strong> {workflow.ai}</p>
                      <p><strong>Control</strong> {workflow.control}</p>
                      <p><strong>Proposed measure</strong> {workflow.measure}</p>
                    </article>
                  ))}
                  <p class="pb-slide-note">Dirk’s recommended operating model. Illustrative workflows, not case studies.</p>
                </div>
              )}

              {section.id === 'from-observation-to-correction' && (
                <div class="pb-slide-foundation" aria-label="Start with existing systems, assess gaps, invest where justified">
                  {presentationFoundationSteps.map((step, index) => (
                    <article>
                      <span>0{index + 1}</span>
                      <h2>{step.title}</h2>
                      <p>{step.detail}</p>
                    </article>
                  ))}
                  <p class="pb-slide-note">Product-data ownership, sufficient PIM capability and appropriate feeds/APIs support reliable work. A new PIM is not required for every first experiment; APIs do not guarantee assistant visibility.</p>
                </div>
              )}

              {section.showTools && (
                <div class="pb-slide-tool-flow" aria-label="Attributed provider capabilities by expert job">
                  {audienceToolRoles.map((tool) => (
                    <article class="pb-slide-tool-stage">
                      <h2 class="pb-slide-tool-job">{tool.provider}</h2>
                      <p class="pb-slide-tool-role">{tool.stageRole}</p>
                      <p><strong>Vendor-described</strong> {tool.stageCapability}</p>
                      <p class="pb-slide-note">{tool.stageBoundary}</p>
                      <nav class="pb-slide-sources" aria-label={`Sources for ${tool.provider}`}>
                        {tool.sourceIds.map((sourceId) => (
                          <a href={sourceById[sourceId].url} target="_blank" rel="noreferrer">{sourceById[sourceId].publisher}</a>
                        ))}
                      </nav>
                      {tool.provider === 'Geoffy' && (
                        <figure class="pb-geoffy-demo">
                          <figcaption>Geoffy demo video withheld from the shared presentation pending content review and reuse permission.</figcaption>
                        </figure>
                      )}
                    </article>
                  ))}
                  <p class="pb-slide-note">Vendor descriptions are not independent outcomes or Commonwork demonstrations.</p>
                </div>
              )}

              {section.showResources && (
                <div class="pb-contact pb-contact-slide">
                  <ol class="pb-next-steps" aria-label="Bounded retailer test steps">
                    {presentationFirstMonthSteps.map((step) => <li><strong>{step.title}</strong><br />{step.detail}</li>)}
                  </ol>
                  <p class="pb-slide-closing">Start with one customer task—not a platform replacement.</p>
                  <a class="pb-slide-worksheet-link" href={`${eventHome}/guide#check-your-visibility`}>Optional exercise: visibility worksheet</a>
                  <button class="pb-btn pb-panel-debate-trigger" type="button" data-open-panel-debate>Panel Debate Statements</button>
                  <dialog class="pb-panel-debate-dialog" aria-labelledby="panel-debate-title" data-panel-debate-dialog>
                    <div class="pb-panel-debate-heading">
                      <div>
                        <p class="pb-eyebrow">Slide 8 · Panel discussion</p>
                        <h2 id="panel-debate-title">Panel Debate Statements</h2>
                      </div>
                      <button class="pb-btn" type="button" data-close-panel-debate>Close debate prompts</button>
                    </div>
                    <div class="pb-panel-debate-list">
                      {panelDebatePrompts.map((prompt, index) => (
                        <article class="pb-panel-debate-card">
                          <p class="pb-panel-debate-number">0{index + 1}</p>
                          <h3>{prompt.topic}</h3>
                          <p><strong>Statement</strong> {prompt.statement}</p>
                          <p><strong>Debate question</strong> {prompt.question}</p>
                        </article>
                      ))}
                    </div>
                  </dialog>
                </div>
              )}

              <nav class="pb-slide-sources" aria-label={`Sources for section ${section.number}`}>
                {section.id !== 'tools-by-job' && section.id !== 'decision-before-visit' && section.id !== 'next-retailer-test' && section.sources.map((source) => (
                  <a href={source.url} target="_blank" rel="noreferrer">{source.publisher} · {source.publishedAt}</a>
                ))}
              </nav>
            </div>
          </section>
        ))
      }
    </main>

    <footer class="pb-deck-controls" aria-label="Slide controls">
      <button class="pb-btn" type="button" data-prev aria-label="Previous slide">Previous</button>
      <nav class="pb-dots" aria-label="Slides">
        <a href="#opening" data-dot aria-label="Opening slide: Agentic Commerce">Title</a>
        {
          sections.map((section) => (
            <a href={`#${section.id}`} data-dot aria-label={`Slide ${section.number}: ${section.title}`}>
              {section.number}
            </a>
          ))
        }
      </nav>
      <button class="pb-btn pb-btn-primary" type="button" data-next aria-label="Next slide">Next</button>
    </footer>

    <p class="pb-sr-only" aria-live="polite" data-announce></p>
  </div>
</PlaybookLayout>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) {
    const slides = Array.from(deck.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(deck.querySelectorAll<HTMLAnchorElement>('[data-dot]'));
    const prev = deck.querySelector<HTMLButtonElement>('[data-prev]');
    const next = deck.querySelector<HTMLButtonElement>('[data-next]');
    const announce = deck.querySelector<HTMLElement>('[data-announce]');
    const fullscreen = deck.querySelector<HTMLButtonElement>('[data-fullscreen]');
    const panelDebateDialog = deck.querySelector<HTMLDialogElement>('[data-panel-debate-dialog]');
    const openPanelDebate = deck.querySelector<HTMLButtonElement>('[data-open-panel-debate]');
    const closePanelDebate = deck.querySelector<HTMLButtonElement>('[data-close-panel-debate]');
    let current = 0;

    const indexFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      const found = slides.findIndex((slide) => slide.id === id);
      return found === -1 ? 0 : found;
    };
    const show = (index: number, updateHash: boolean) => {
      if (panelDebateDialog?.open) panelDebateDialog.close();
      current = Math.min(Math.max(index, 0), slides.length - 1);
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute('aria-current', 'step');
        else dot.removeAttribute('aria-current');
      });
      if (prev) prev.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
      const title = slides[current].querySelector('h1')?.textContent ?? '';
      if (announce) announce.textContent = `Slide ${current + 1} of ${slides.length}: ${title}`;
      if (updateHash) history.replaceState(null, '', `#${slides[current].id}`);
      slides[current].scrollTop = 0;
    };

    deck.dataset.enhanced = 'true';
    show(indexFromHash(), false);

    openPanelDebate?.addEventListener('click', () => panelDebateDialog?.showModal());
    closePanelDebate?.addEventListener('click', () => panelDebateDialog?.close());
    prev?.addEventListener('click', () => show(current - 1, true));
    next?.addEventListener('click', () => show(current + 1, true));
    window.addEventListener('hashchange', () => show(indexFromHash(), false));

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey || panelDebateDialog?.open) return;
      const target = event.target as HTMLElement | null;
      // Never steal keys from form fields, links or editable content.
      if (target?.closest('input, textarea, select, a, [contenteditable=""], [contenteditable="true"]')) return;
      const onButton = Boolean(target?.closest('button, summary'));

      switch (event.key) {
        case 'ArrowRight':
        case 'PageDown':
          show(current + 1, true);
          break;
        case 'ArrowLeft':
        case 'PageUp':
          show(current - 1, true);
          break;
        case 'Home':
          show(0, true);
          break;
        case 'End':
          show(slides.length - 1, true);
          break;
        case ' ':
          if (onButton) return;
          show(event.shiftKey ? current - 1 : current + 1, true);
          break;
        default:
          return;
      }
      event.preventDefault();
    });

    if (fullscreen && document.fullscreenEnabled) {
      fullscreen.hidden = false;
      const label = () => {
        fullscreen.textContent = document.fullscreenElement ? 'Leave full screen' : 'Full screen';
      };
      fullscreen.addEventListener('click', () => {
        if (document.fullscreenElement) void document.exitFullscreen();
        else void document.documentElement.requestFullscreen().catch(() => undefined);
      });
      document.addEventListener('fullscreenchange', label);
    }
  }
</script>
