---
import { getCollection } from 'astro:content';
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import { readPublicLisbonAccess } from '../../../lib/events/event-code-server';
import { deliveryError, deliveryHeaders } from '../../../lib/events/object-delivery';
import { getEventIdentity } from '../../../lib/events/inretail-2026';
import { getEventCatalogueSelections } from '../../../lib/event-catalogue';
import '../../../styles/events.css';
export const prerender = false;
let access;
try { access = await readPublicLisbonAccess(Astro.params.slug ?? ''); } catch { return deliveryError('Event resources are temporarily unavailable.', 503); }
if (!access) return deliveryError('Event resources not found.', 404);
for (const [key, value] of Object.entries(deliveryHeaders)) Astro.response.headers.set(key, value);
const base = `/events/${access.event.slug}`;
const identity = getEventIdentity(access.event.id);
const selections = getEventCatalogueSelections(access.event.id);
const offerings: Record<string, { name: string; provider: string; role: string; source: string }> = {
  geoffy: { name: 'Geoffy', provider: 'Geoffy', role: 'Product information', source: 'https://geoffy.ai/' },
  admultify: { name: 'AdMultify', provider: 'Begen', role: 'Creative production', source: 'https://begen.ai/' },
  'rierino-commerce-platform': { name: 'Rierino Commerce', provider: 'Rierino', role: 'Commerce operations', source: 'https://rierino.com/solutions/commerce' },
  'be-cited': { name: 'Be.Cited', provider: 'Benext', role: 'AI-answer visibility', source: 'https://becited.com.br/' },
};
const brandingAssets = new Set(Object.keys(import.meta.glob('/public/events/inretail-2026/*')).map((path) => path.replace('/public', '')));
const articles = (await getCollection('insights')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 2);
const dateTime = (value: string) => new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Lisbon' }).format(new Date(value));
---
<EditorialLayout title={identity?.sessionTitleEn || access.event.title} description={identity?.summary || access.event.summary || 'Public InRetail session resources hosted by Commonwork.'}>
  <div class="event-page">
    <header class="event-hero">
      <div class="eyebrow">{identity ? `${identity.parentEventName} · ${identity.theme} · ${identity.edition}` : 'InRetail · Public session resources'}</div>
      <h1>{identity?.sessionTitleEn || access.event.title}</h1>
      {identity && <p lang="pt">Official programme title: “{identity.sessionTitlePt}”</p>}
      <p class="lede">{identity?.summary || access.event.summary}</p>
    </header>
    <section class="event-resource-actions" aria-labelledby="materials-heading">
      <h2 id="materials-heading">Presentation and audience guide</h2>
      <p>These session resources are public with the event organizer’s permission. No account or event code is required.</p>
      <div class="event-actions"><a class="btn btn-primary" href={`${base}/presentation`}>Open presentation</a><a class="btn" href={`${base}/guide`}>Open audience guide and worksheet</a></div>
      <p>The presentation includes the four supplier videos. The audience guide contains sources, the exercise and worksheet, with a print / save as PDF option.</p>
      <p class="event-note" role="status">The downloadable presentation PDF is being updated to match the current slides.</p>
    </section>
    {identity && <section aria-labelledby="session-details-heading">
      <h2 id="session-details-heading">Session details</h2>
      {brandingAssets.has(identity.eventMark.src) && <img class="event-resource-banner" src={identity.eventMark.src} alt={identity.eventMark.alt} width={identity.eventMark.width} height={identity.eventMark.height} />}
      <dl class="event-facts"><div><dt>Conference</dt><dd>{identity.datesLabel}</dd></div><div><dt>Venue</dt><dd>{identity.venue}</dd></div><div><dt>Session</dt><dd>{dateTime(identity.presentation.startsAt)} (Lisbon time)</dd></div><div><dt>Track</dt><dd lang="pt">{identity.trackTitle}</dd></div></dl>
      <ul class="event-topics">{identity.topics.map((topic) => <li>{topic}</li>)}</ul>
    </section>}
    {identity && <section class="event-details" aria-labelledby="programme-heading">
      <div class="event-programme"><h2 id="programme-heading">Session programme</h2><ol class="event-runsheet"><li><div><p class="event-runsheet-label">{identity.presentation.label} · {dateTime(identity.presentation.startsAt)}</p><p>{identity.presenter.name} · {identity.presenter.role} · {identity.presenter.organisation}</p></div></li><li><div><p class="event-runsheet-label">{identity.debate.label} · {dateTime(identity.debate.startsAt)}</p>{identity.debaters.map((person) => <p>{person.name} · {person.role} · {person.organisation}</p>)}<p>Moderator: {identity.moderator.name} · {identity.moderator.role} · {identity.moderator.organisation}</p></div></li></ol><p class="event-note">Programme times are shown in Lisbon time. No session end time is published.</p></div>
      <div class="event-organisers"><h3>Organisation</h3><div class="event-resource-organiser-marks">{identity.organisers.filter((asset) => brandingAssets.has(asset.src)).map((asset) => <img src={asset.src} alt={asset.alt} width={asset.width} height={asset.height} loading="lazy" />)}</div><p>Distribuição Hoje · Skolae Formação</p><a href={identity.programmeUrl} target="_blank" rel="noopener noreferrer">Official event programme</a><p class="event-note">Presented by Dirk Buursma for Commerce Partners. Session resources hosted by Commonwork.</p></div>
    </section>}
    {selections.length > 0 && <section class="event-related" aria-labelledby="catalogue-heading"><div class="eyebrow">Connected to this session</div><h2 id="catalogue-heading">Event catalogue</h2><p>Four offerings for four different jobs. Inclusion is not sponsorship, endorsement, a ranking or evidence of integration with Commonwork. Capabilities are attributed to their publishers; suitability and outcomes require validation.</p><ul class="event-card-grid">{selections.map((selection) => { const offering = offerings[selection.productSlug]; return offering && <li class="event-card"><span class="event-card-desk">{offering.provider} · {offering.role}</span><h3>{offering.name}</h3><p class="event-card-relevance">{selection.relevance}</p><p><a class="event-card-title" href={`/intelligence/product/${selection.productSlug}?from_event=${encodeURIComponent(access.event.slug)}`}>Open catalogue entry</a></p><a href={offering.source} target="_blank" rel="noopener noreferrer">Provider source</a></li>; })}</ul><p class="event-note">These session summaries and provider links are public. Full Commonwork catalogue pages currently require sign-in and workspace membership; signing in alone does not grant membership.</p>{Astro.locals.user && <p><a href="/intelligence">Browse the Commonwork catalogue</a></p>}</section>}
    {articles.length > 0 && <section class="event-related" aria-labelledby="insights-heading"><h2 id="insights-heading">Continue exploring: Insights</h2><ul class="event-card-grid">{articles.map((article) => <li class="event-card"><span class="event-card-desk">{article.data.desk}</span><a class="event-card-title" href={`/insights/${article.id}`}>{article.data.title}</a><p class="event-card-summary">{article.data.deck}</p></li>)}</ul><p><a href="/insights">All Insights and reviews</a> · <a href="/about">About Commonwork</a></p></section>}
    <section class="event-contact"><h2>Questions about this session</h2><p><a href="mailto:dirk.buursma@commerce-partners.com">dirk.buursma@commerce-partners.com</a></p><p>Viewing the public session resources does not create a Commonwork account or grant workspace membership.</p></section>
  </div>
</EditorialLayout>
<style>
  .event-resource-actions { padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--card); }
  .event-resource-actions > :last-child { margin-bottom: 0; }
  .event-resource-banner { display: block; width: 100%; height: auto; margin: 0 0 1.5rem; border-radius: 10px; }
  .event-resource-organiser-marks { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .event-resource-organiser-marks img { max-width: 180px; width: auto; height: 70px; object-fit: contain; }
  .event-page > section { margin-top: 2rem; }
</style>
