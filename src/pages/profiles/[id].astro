---
import AppLayout from '../../layouts/AppLayout.astro';
import EmptyState from '../../components/app/EmptyState.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import type {
  CompetenceEvidence,
  ContactPreferences,
  DiscoverableContactPreferences,
  DiscoverableProfile,
  MemberProfile,
  ProfileCompetence,
} from '../../lib/competence-data';
import type { BlockedIntroductionMember, ContactMethod, PrivacyRequest } from '../../lib/introduction-data';
import {
  getCompetenceEvidence,
  getContactPreferences,
  getDiscoverableContactPreferences,
  getDiscoverableProfile,
  getMyProfile,
  getProfileCompetencies,
} from '../../lib/competence-data';
import { getMyContactMethods, getMyIntroductionBlocks, getMyPrivacyRequests } from '../../lib/introduction-data';

const user = Astro.locals.user;
const localPreview = user?.isLocalTestUser === true;
const requestedId = Astro.params.id ?? '';
const isOwner = requestedId === 'me' || requestedId === user?.id;
const profileId = requestedId === 'me' ? (user?.id ?? '') : requestedId;
const supabase = localPreview ? null : createSupabaseServerClient(Astro);
let profile: MemberProfile | DiscoverableProfile | null = null;
let competencies: ProfileCompetence[] = [];
let evidence: CompetenceEvidence[] = [];
let preferences: ContactPreferences | DiscoverableContactPreferences | null = null;
let contactMethods: ContactMethod[] = [];
let privacyRequests: PrivacyRequest[] = [];
let blockedMembers: BlockedIntroductionMember[] = [];
let loadError = false;

if (!localPreview && supabase && profileId) {
  try {
    profile = isOwner
      ? await getMyProfile(supabase)
      : await getDiscoverableProfile(supabase, profileId);
    if (profile) {
      [competencies, preferences] = await Promise.all([
        getProfileCompetencies(supabase, profileId),
        isOwner
          ? getContactPreferences(supabase, profileId)
          : getDiscoverableContactPreferences(supabase, profileId),
      ]);
      if (isOwner) {
        [contactMethods, privacyRequests, blockedMembers] = await Promise.all([
          getMyContactMethods(supabase),
          getMyPrivacyRequests(supabase),
          getMyIntroductionBlocks(supabase),
        ]);
      } else {
        blockedMembers = await getMyIntroductionBlocks(supabase);
      }
      evidence = await getCompetenceEvidence(supabase, competencies.map((item) => item.id));
    }
  } catch {
    loadError = true;
  }
}

const preferenceLabels = [
  ['open_to_peer_exchange', 'Peer exchange'],
  ['open_to_advisory', 'Advisory conversations'],
  ['open_to_projects', 'Projects'],
  ['open_to_partnerships', 'Partnerships'],
  ['open_to_opportunities', 'Professional opportunities'],
  ['open_to_event_introductions', 'Event introductions'],
] as const;
const categoryLabels = {
  knowledge: 'Knowledge',
  practical_capability: 'Practical capabilities',
  way_of_working: 'Ways of working',
} as const;
const groupedCompetencies = Object.entries(categoryLabels).map(([category, label]) => ({
  category,
  label,
  items: competencies.filter((item) => item.competencies?.category === category),
}));
const status = Astro.url.searchParams.get('status');
const contactStatusMessages: Record<string, string> = {
  'contact-method-saved': 'Contact method saved privately.',
  'contact-method-removed': 'Contact method removed.',
  'contact-method-invalid': 'Check the contact method details and try again.',
  'contact-method-failed': 'The contact method could not be saved.',
  'preview-readonly': 'Local preview is read-only; contact methods require a signed-in Supabase member.',
  'profile-deactivated': 'Your profile is private, competencies are hidden, and availability is withdrawn.',
  'deletion-requested': 'Your account deletion request is recorded for administrator review.',
  'export-requested': 'Your data export request is recorded.',
  'privacy-request-cancelled': 'Privacy request cancelled.',
  'privacy-action-failed': 'The privacy action could not be completed.',
  'export-failed': 'Your data export could not be created.',
  'member-blocked': 'This member cannot request an introduction to you.',
  'member-unblocked': 'This member may request an introduction if otherwise eligible.',
  'block-action-failed': 'The block preference could not be saved.',
};
const isBlockedByMe = blockedMembers.some((entry) => entry.blocked_profile_id === profileId);
---

<AppLayout title="Competence profile" section="competence">
  {localPreview ? (
    <div class="stack">
      <div class="form-notice" role="status">Database features require Supabase sign-in. The local preview login is read-only and does not represent a database member.</div>
      <section class="panel panel-pad"><EmptyState symbol="◇" title="Member profiles are not connected" description="Sign in through Supabase to view a real member profile." /></section>
    </div>
  ) : !supabase ? (
    <p class="form-notice error" role="alert">Supabase is not configured. Profile data cannot be loaded.</p>
  ) : loadError ? (
    <p class="form-notice error" role="alert">We could not load this profile. Please try again shortly.</p>
  ) : !profile ? (
    <section class="panel panel-pad"><EmptyState symbol="·" title="Profile unavailable" description="This profile may be private, incomplete or no longer available." /></section>
  ) : (
    <>
      {status === 'preferences-saved' && <p class="form-notice" role="status">Conversation preferences saved.</p>}
      {status && contactStatusMessages[status] && <p class="form-notice" role={status === 'contact-method-failed' || status === 'contact-method-invalid' ? 'alert' : 'status'}>{contactStatusMessages[status]}</p>}
      <div class="page-head">
        <div>
          <div class="eyebrow">Competence profile</div>
          <h1>{profile.display_name}</h1>
          <p class="subtitle">{profile.professional_summary}</p>
        </div>
        {isOwner && <a class="btn" href="/onboarding?step=contribution">Edit profile</a>}
      </div>

      <div class="profile-grid">
        <div class="stack">
          <section class="panel panel-pad">
            <div class="panel-head"><div><h2>What I can contribute</h2></div></div>
            <p>{profile.what_i_contribute}</p>
            {profile.what_i_am_exploring && <><div class="eyebrow">What I am exploring</div><p>{profile.what_i_am_exploring}</p></>}
            {isOwner && 'profile_visibility' in profile && (
              <p class="profile-privacy-note">Profile visibility: {profile.profile_visibility === 'members' ? 'discoverable to signed-in members' : 'private to you'}</p>
            )}
          </section>

          <section class="panel panel-pad">
            <div class="panel-head"><div><h2>Competencies</h2><p>Knowledge, practical capabilities and ways of working.</p></div></div>
            {competencies.length === 0 ? (
              <EmptyState symbol="＋" title="No competencies to show" description={isOwner ? 'Add a competence to begin building your profile.' : 'This member has not added discoverable competencies yet.'}>
                {isOwner && <a class="btn" href="/onboarding?step=competencies">Add a competence</a>}
              </EmptyState>
            ) : (
              <div class="competence-groups">
                {groupedCompetencies.filter((group) => group.items.length > 0).map((group) => (
                  <section class="competence-group" aria-label={group.label}>
                    <h3>{group.label}</h3>
                    <div class="competence-list">
                      {group.items.map((item) => (
                        <article class="competence-item">
                          <div class="competence-item-copy">
                            <h4>{item.competencies?.name}</h4>
                            <p>{item.member_statement}</p>
                            {isOwner && <span class="status-note">{item.evidence_status === 'demonstrated' ? 'Demonstrated' : 'Declared'}</span>}
                            {item.discoverable && <span class="status-note">Discoverable</span>}
                          </div>
                          {evidence.filter((entry) => entry.profile_competency_id === item.id).map((entry) => (
                            <div class="evidence-item">
                              <div>
                                <strong>{entry.title}</strong>
                                <p><span class="evidence-label">Context:</span> {entry.context}</p>
                                <p><span class="evidence-label">Contribution:</span> {entry.contribution}</p>
                                <p><span class="evidence-label">Outcome:</span> {entry.outcome}</p>
                              </div>
                              {entry.evidence_url && <a class="text-link" href={entry.evidence_url} target="_blank" rel="noreferrer">Open supporting link</a>}
                            </div>
                          ))}
                        </article>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            )}
          </section>
        </div>

        <aside class="stack" aria-label="Conversation preferences">
          <section class="panel panel-pad">
            <div class="panel-head"><div><h2>Conversations I welcome</h2><p>Only options explicitly enabled are shown.</p></div></div>
            {preferences ? (
              <>
                {preferenceLabels.filter(([key]) => preferences[key]).map(([, label]) => <div class="stat-row"><span>{label}</span><strong>Open</strong></div>)}
                {!preferenceLabels.some(([key]) => preferences[key]) && <p class="subtitle">No conversation types selected.</p>}
                <div class="stat-row"><span>Availability</span><strong>{preferences.availability_status.replaceAll('_', ' ')}</strong></div>
                <div class="stat-row"><span>Monthly capacity</span><strong>{preferences.conversation_capacity}</strong></div>
                {isOwner && 'commercial_approaches' in preferences && <div class="stat-row"><span>Commercial approaches</span><strong>{preferences.commercial_approaches ? 'Allowed' : 'Closed'}</strong></div>}
              </>
            ) : <p class="subtitle">Conversation preferences are not available.</p>}
            {isOwner && <a class="btn" href="/onboarding?step=conversations">Edit preferences</a>}
          </section>
          {isOwner && (
            <section class="panel panel-pad">
              <div class="eyebrow">Private profile settings</div>
              <p>Your email address and private evidence are not displayed on this member profile.</p>
            </section>
          )}
          {isOwner && (
            <section class="panel panel-pad" aria-labelledby="contact-methods-title">
              <div class="panel-head"><div><h2 id="contact-methods-title">Contact methods for introductions</h2><p>These stay private until you consent to a completed introduction. Your sign-in email is never copied here automatically.</p></div></div>
              {contactMethods.length > 0 ? (
                <ul class="contact-method-list">
                  {contactMethods.map((method) => (
                    <li><div><strong>{method.label || (method.method_type === 'email' ? 'Email address' : 'Calendar link')}</strong>{method.is_primary && <span class="need-status saved">Primary</span>}<p>{method.method_type === 'email' ? 'Email' : 'Calendar link'} · {method.value}</p></div><form method="post" action="/api/contact-methods"><input type="hidden" name="action" value="delete" /><input type="hidden" name="method_id" value={method.id} /><button class="btn" type="submit" aria-label={`Remove ${method.label || method.method_type}`}>Remove</button></form></li>
                  ))}
                </ul>
              ) : <p class="subtitle">No contact method is configured yet.</p>}
              <form method="post" action="/api/contact-methods" class="contact-method-form">
                <input type="hidden" name="action" value="save" />
                <label class="field">Type<select name="method_type"><option value="email">Email I choose to share</option><option value="calendar_url">Calendar URL</option></select></label>
                <label class="field">Contact value<input name="value" required maxlength="2048" autocomplete="off" placeholder="Email address or https:// calendar link" /></label>
                <label class="field">Label<input name="label" maxlength="120" placeholder="For example, Work email" /></label>
                <label class="preference-option"><input type="checkbox" name="is_primary" /><span>Set as primary</span></label>
                <button class="btn primary" type="submit">Save contact method</button>
              </form>
            </section>
          )}
          {isOwner && (
            <section class="panel panel-pad" aria-labelledby="privacy-operations-title">
              <div class="panel-head"><div><h2 id="privacy-operations-title">Privacy and account controls</h2><p>Manage your discoverability and request data operations.</p></div></div>
              <a class="btn" href="/api/privacy">Download my data</a>
              <form method="post" action="/api/privacy" class="privacy-action-form"><input type="hidden" name="action" value="deactivate" /><button class="btn" type="submit">Deactivate profile and withdraw availability</button></form>
              <form method="post" action="/api/privacy" class="privacy-action-form"><input type="hidden" name="action" value="request-deletion" /><label class="field">Optional note for the administrator<textarea name="member_note" maxlength="2000" rows="2"></textarea></label><button class="btn" type="submit">Request account deletion</button></form>
              {privacyRequests.length > 0 && <div class="privacy-request-list"><h3>Your privacy requests</h3>{privacyRequests.map((request) => <div class="privacy-request-item"><span>{request.request_type.replaceAll('_', ' ')} · {request.status.replaceAll('_', ' ')}</span>{request.status === 'pending' && <form method="post" action="/api/privacy"><input type="hidden" name="action" value="cancel-request" /><input type="hidden" name="request_id" value={request.id} /><button class="btn" type="submit">Cancel request</button></form>}</div>)}</div>}
              {blockedMembers.length > 0 && <div class="privacy-request-list"><h3>Blocked future introductions</h3>{blockedMembers.map((blocked) => <div class="privacy-request-item"><span>{blocked.blocked_display_name}</span><form method="post" action={`/api/members/${blocked.blocked_profile_id}/block`}><input type="hidden" name="action" value="unblock" /><button class="btn" type="submit">Allow future introductions</button></form></div>)}</div>}
            </section>
          )}
          {!isOwner && (
            <section class="panel panel-pad" aria-label="Introduction boundary">
              <div class="eyebrow">Introduction preferences</div>
              <p class="subtitle">Blocking prevents new introductions between you and this member. It does not affect an existing introduction.</p>
              <form method="post" action={`/api/members/${profileId}/block`}><input type="hidden" name="action" value={isBlockedByMe ? 'unblock' : 'block'} /><button class="btn" type="submit">{isBlockedByMe ? 'Allow future introductions' : 'Block future introductions'}</button></form>
            </section>
          )}
        </aside>
      </div>
    </>
  )}
</AppLayout>
